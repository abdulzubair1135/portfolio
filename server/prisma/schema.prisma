datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password_hash String
  role          String   @default("admin")
  created_at    DateTime @default(now())

  @@map("users")
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  projects    Project[]

  @@map("categories")
}

model Project {
  id                String               @id @default(uuid())
  name              String
  slug              String               @unique
  category_id       String
  category          Category             @relation(fields: [category_id], references: [id])
  description       String
  long_description  String?
  featured          Boolean              @default(false)
  status            String               @default("published")
  sort_order        Int                  @default(0)
  created_at        DateTime             @default(now())
  updated_at        DateTime             @updatedAt
  images            ProjectImage[]
  technologies      ProjectTechnology[]
  links             ProjectLink[]
  downloads         Download[]
  world_objects     WorldObject[]

  @@map("projects")
}

model ProjectImage {
  id         String   @id @default(uuid())
  project_id String
  project    Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  image_url  String
  image_type String   @default("screenshot")
  sort_order Int      @default(0)

  @@map("project_images")
}

model ProjectTechnology {
  id              String  @id @default(uuid())
  project_id      String
  project         Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  technology_name String

  @@map("project_technologies")
}

model ProjectLink {
  id         String  @id @default(uuid())
  project_id String
  project    Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  link_type  String  // "github", "live", "demo"
  url        String
  label      String

  @@map("project_links")
}

model Download {
  id         String  @id @default(uuid())
  project_id String
  project    Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  file_name  String
  file_url   String
  file_type  String  // "apk", "pdf", "zip"
  file_size  String?

  @@map("downloads")
}

model WorldZone {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  description String?
  position_x  Float
  position_y  Float
  position_z  Float
  objects     WorldObject[]

  @@map("world_zones")
}

model WorldObject {
  id                 String     @id @default(uuid())
  project_id         String?
  project            Project?   @relation(fields: [project_id], references: [id], onDelete: SetNull)
  zone_id            String
  zone               WorldZone  @relation(fields: [zone_id], references: [id], onDelete: Cascade)
  position_x         Float
  position_y         Float
  position_z         Float
  interaction_radius Float      @default(6.0)

  @@map("world_objects")
}

model ContactMessage {
  id         String   @id @default(uuid())
  name       String
  email      String
  subject    String?
  message    String
  created_at DateTime @default(now())
  status     String   @default("unread")

  @@map("contact_messages")
}

model SiteSetting {
  id            String @id @default(uuid())
  setting_key   String @unique
  setting_value String

  @@map("site_settings")
}

model VisitorAnalytics {
  id         String   @id @default(uuid())
  event_type String   // "zone_enter", "project_view", "download", "contact_sent"
  project_id String?
  created_at DateTime @default(now())

  @@map("visitor_analytics")
}
